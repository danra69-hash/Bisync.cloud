# Build outputs
bin/
obj/

# SQLite temp/lock files (never commit these)
*.db-shm
*.db-wal

# Ignore other databases; allow Bisync app DB and named backups under src/Bisync.Api/
*.db
!src/Bisync.Api/
!src/Bisync.Api/*.db

# Local backup copies (optional — run scripts/backup-data.ps1)
data-backups/

# Stock card archive database (generated by StockCardArchiveService)
data-archives/stock-card/*.db

# .NET
.vs/
*.user
*.suo

# Node
node_modules/
client/dist/
dist/

# SPA publish output (Docker/CI copies client/dist here; never commit local builds)
src/Bisync.Api/wwwroot/

# Environment
.env
.env.local
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp

# Local agent/build scratch
tmp-build*/

artifacts/

