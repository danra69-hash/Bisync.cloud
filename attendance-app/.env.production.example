# Copy to .env.production locally (do not commit secrets).
# Production uses Pages _worker.js proxy at /identity and /mobile-api (Identity has no CORS).
VITE_API_BASE_URL=https://mobileapi.bisync.cloud/
VITE_TOKEN_BASE_URL=https://identity.bisync.cloud/
VITE_CLIENT_ID=rms
VITE_CLIENT_SECRET=your-production-client-secret
VITE_USE_PROXY=true
VITE_DEV_BYPASS_AUTH=false

# Firebase Cloud Messaging (Web) — project cubevalue-d7497
# REQUIRED for closed-app push (service worker). Without APP_ID + VAPID the SW
# builds with firebaseConfig=null and background notifications never show.
#
# Setup:
# 1) https://console.firebase.google.com/project/cubevalue-d7497/settings/general
# 2) Your apps → Add app → Web → register (e.g. "Bisync RMS Mobile")
# 3) Copy the web appId (starts with 1:1063716983721:web:…)
# 4) Project settings → Cloud Messaging → Web Push certificates → Generate key pair
# 5) Paste below, then: npm run build && python scripts/deploy-pages-with-worker.py
#
VITE_FIREBASE_API_KEY=AIzaSyD2KrI861dPPIfZx1nZeRRN42j89oOFUhs
VITE_FIREBASE_AUTH_DOMAIN=cubevalue-d7497.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cubevalue-d7497
VITE_FIREBASE_STORAGE_BUCKET=cubevalue-d7497.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1063716983721
VITE_FIREBASE_APP_ID=1:1063716983721:web:REPLACE_WITH_WEB_APP_ID
VITE_FIREBASE_VAPID_KEY=REPLACE_WITH_WEB_PUSH_CERTIFICATE_KEY_PAIR
