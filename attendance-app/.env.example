# Copy to .env (dev) or .env.production (npm run build) and fill in values. Do not commit real secrets.
VITE_API_BASE_URL=https://uat.mobileapi.bisync.cloud
VITE_TOKEN_BASE_URL=https://uat.identity.bisync.cloud
VITE_CLIENT_ID=rms
VITE_CLIENT_SECRET=your-client-secret-here
# Dev only — use false in .env.production (proxy does not exist in static deploy)
VITE_USE_PROXY=true
VITE_DEV_BYPASS_AUTH=false
VITE_DEV_USERNAME=your-dev-username
VITE_DEV_PASSWORD=your-dev-password

# Attendance — false = Bisync.cloud HR module; true = localStorage demo
VITE_ATTENDANCE_MOCK=false
VITE_CLOCK_MODE=true
VITE_HR_API_BASE_URL=http://127.0.0.1:5299

# Firebase Cloud Messaging (Web) — project cubevalue-d7497 (same as Flutter)
# Create a Web app in Firebase Console → Project settings → Your apps
# Cloud Messaging → Web Push certificates → Key pair = VAPID
VITE_FIREBASE_API_KEY=AIzaSyD2KrI861dPPIfZx1nZeRRN42j89oOFUhs
VITE_FIREBASE_AUTH_DOMAIN=cubevalue-d7497.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cubevalue-d7497
VITE_FIREBASE_STORAGE_BUCKET=cubevalue-d7497.appspot.com
