{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.{js,css,png,jpg,jpeg,gif,ico,svg,webp,woff,woff2,webmanifest}"
    ]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  }
}
